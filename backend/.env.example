# AI PR Reviewer — Environment Configuration
# Copy to .env and fill in your values.

# --- AI Engine ---
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# --- GitHub Integration ---
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# --- GitHub App (optional — for installation-based repo access) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_NAME=
GITHUB_APP_INSTALL_URL=

# --- Session & Security ---
SESSION_SECRET=change_this_to_a_long_random_string
ENVIRONMENT=development

# --- Server ---
PORT=8000
APP_URL=http://localhost:8000

# --- Database (PostgreSQL required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/hcl_reviewer
